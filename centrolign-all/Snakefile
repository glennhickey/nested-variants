            " ' :{input.sv_onref}'"


    rule concat_call_per_sample_by_chrom:
        """Concatenate per-chrom call per-sample TSVs with chrom column (6c source data)"""
        input:
            expand(f"{OUT}/{{c}}.call.sites.pass.per-sample-types.tsv", c=CALL_CHROMS),
        output:
            f"{OUT}/6c.per-sample-by-chrom.tsv",
        run:
            with open(output[0], "w") as out:
                out.write("chrom\tsample\tvariant_type\tref_context\tcount\n")
                for f in input:
                    chrom = os.path.basename(f).replace(".call.sites.pass.per-sample-types.tsv", "")
                    with open(f) as inp:
                        next(inp)
                        for line in inp:
                            out.write(f"{chrom}\t{line}")


    rule summary_call_per_sample_by_chrom_combined:
        """Compose compact call per-sample by chromosome, off+on-ref overlaid (figure 6c)"""
        resources:
            mem_mb=32000,
            runtime=960,
        input:
            snp=f"{OUT}/all.call.by-chrom.per-sample-snp-combined.png",

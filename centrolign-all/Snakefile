# Snakefile — multi-chromosome centromere augref analysis
#
# Discovers *.gbz files in the working directory and runs the augref +
# deconstruct pipeline on each, then aggregates results into summary figures.
#
# Usage:
#   source ../venv-nested-variants/bin/activate
#   snakemake --cores 8 -np   # dry run
#   snakemake --cores 8        # full run

import os
import sys
import glob as _glob

SCRIPTS = "../scripts"
REF = config.get("ref", "CHM13")
AUGREF = f"augref_{REF}"
OUT = config.get("out", "output-all")
MIN_AUGREF_LEN = config.get("min_augref_len", 50)
READS_DIR = config.get("reads_dir", "reads")
SKIP_HAPL = set(config.get("skip_hapl", "").split(",")) - {""}
# Memory cap passed to scripts (KMC, DV). On cluster, 256 GB; for local
# testing, override with --config mem_gb=16
MEM_GB = int(config.get("mem_gb", 256))

# Chromosomes: specify via --config chroms="chr6,chr12" or auto-discover from *.gbz
if "chroms" in config:
    CHROMS = config["chroms"].split(",")
else:
    CHROMS = sorted(
        [os.path.basename(f).replace(".gbz", "")
         for f in _glob.glob("*.gbz")
         if ".giraffe." not in f],
        key=lambda c: (len(c), c),
    )


# Auto-discover read samples from reads/ directory
# Naming: {chrom}.{sample}.{hap}.real.fastq.gz
# Builds CHROM_SAMPLES = {chrom: {sample: [fastq1, fastq2]}}
CHROM_SAMPLES = {}
for fq in sorted(_glob.glob(f"{READS_DIR}/*.real.fastq*")):
    base = os.path.basename(fq).split(".")
    chrom, sample = base[0], base[1]
    if chrom in CHROMS:
        CHROM_SAMPLES.setdefault(chrom, {}).setdefault(sample, []).append(
            os.path.abspath(fq))

# Chromosomes that have both a GBZ and reads
CALL_CHROMS = sorted(
    [c for c in CHROMS if c in CHROM_SAMPLES],
    key=lambda c: (len(c), c),
)
# All unique sample names across chromosomes (union)
ALL_SAMPLES = sorted(set(
    s for c in CALL_CHROMS for s in CHROM_SAMPLES[c]
))
# Samples present in ALL call chromosomes (intersection) — needed for cross-chrom
# concat, which requires identical sample sets across per-chrom merged VCFs.
COMMON_SAMPLES = sorted(
    set.intersection(*(set(CHROM_SAMPLES[c]) for c in CALL_CHROMS))
) if CALL_CHROMS else []

# Whether to produce mapping/calling panels (need reads)
HAS_READS = len(CALL_CHROMS) > 0
# Whether to produce aggregate call/DV panels (need at least one sample in every chrom)
HAS_COMMON_SAMPLES = len(COMMON_SAMPLES) > 0
if HAS_READS and not HAS_COMMON_SAMPLES:
    print(f"WARNING: no sample present in all {len(CALL_CHROMS)} chromosomes; "
          f"skipping aggregate call/DV panels (5, 7). Per-chrom and by-chrom "
          f"panels (6, 8) will still be built.", file=sys.stderr)


rule all:
    input:
        f"{OUT}/1.augref-summary.png",
        f"{OUT}/2.deconstruct-summary.png",
        f"{OUT}/3.deconstruct-by-chrom.png",
        f"{OUT}/4.per-sample-by-chrom.png",
        *([f"{OUT}/6.call-by-chrom.png",
           f"{OUT}/8.deepvariant-by-chrom.png",
          ] if HAS_READS else []),
        *([f"{OUT}/5.call-summary.png",
           f"{OUT}/7.deepvariant-summary.png",
          ] if HAS_COMMON_SAMPLES else []),


# --- Per-chromosome graph construction ---

rule gbz_to_vg:
    """GBZ -> VG (set RS header so reference path type is preserved)"""
    input:
        "{chrom}.gbz",
    output:
        "{chrom}.vg",
    resources:
        mem_mb=32000,
        runtime=480,
    shell:
        "vg convert -f {input}"
        " | python3 fix-path-names.py --ref {REF} --header-only"
        " | vg convert -g - > {output}"


rule paths:
    """VG -> augref GFA + segment table"""
    input:
        "{chrom}.vg",
    output:
        gfa=f"{OUT}/{{chrom}}.augref.gfa",
        segs=f"{OUT}/{{chrom}}.augref-segs.tsv",
    threads: 8
    resources:
        mem_mb=64000,
        runtime=960,
    shell:
        "vg paths -x {input} -Q {REF} -u"
        " --min-augref-len {MIN_AUGREF_LEN}"
        " --augref-sample {AUGREF}"
        " --augref-segs {output.segs}"
        " -t {threads}"
        " | vg convert -f - > {output.gfa}"


rule gbz:
    """GFA -> GBZ"""
    input:
        f"{OUT}/{{chrom}}.augref.gfa",
    output:
        f"{OUT}/{{chrom}}.augref.gbz",
    resources:
        mem_mb=32000,
        runtime=480,
    shell:
        "vg gbwt -G {input} --gbz-format -g {output}"


# --- Aggregated augref summary (Panel 1) ---

rule length_hist:
    """All augref-segs -> cumulative length histogram"""
    input:
        expand(f"{OUT}/{{c}}.augref-segs.tsv", c=CHROMS),
    output:
        f"{OUT}/all.augref-length-hist.png",
    shell:
        "Rscript {SCRIPTS}/offref-length-hist.R {output} {input} TRUE"


rule length_hist_log:
    """All augref-segs -> log-log length histogram"""
    input:
        expand(f"{OUT}/{{c}}.augref-segs.tsv", c=CHROMS),
    output:
        f"{OUT}/all.augref-length-hist-log.png",
    shell:
        "Rscript {SCRIPTS}/offref-length-hist.R {output} {input} FALSE"


rule concat_segs:
    """Concatenate per-chromosome augref-segs, rewriting ref_contig to include chrom"""
    input:
        expand(f"{OUT}/{{c}}.augref-segs.tsv", c=CHROMS),
    output:
        f"{OUT}/all.augref-segs.tsv",
    run:
        with open(output[0], "w") as out:
            for f in input:
                chrom = os.path.basename(f).replace(".augref-segs.tsv", "")
                with open(f) as inp:
                    for line in inp:
                        cols = line.rstrip("\n").split("\t")
                        # col 4 (ref_contig): replace CHM13#0#CHM13.0 with CHM13#0#chrom
                        cols[4] = f"{REF}#0#{chrom}"
                        out.write("\t".join(cols) + "\n")


rule segment_density:
    """All augref-segs -> chromosome density ideogram"""
    input:
        f"{OUT}/all.augref-segs.tsv",
    output:
        f"{OUT}/all.offref-segs.png",
    shell:
        "Rscript {SCRIPTS}/chrom-density-tsv.R"
        " {input} {output}"
        " '{REF} Off-Reference Segment Density'"
        " {MIN_AUGREF_LEN} '' log1p"


# --- Per-chromosome deconstruction ---

rule deconstruct:
    """GBZ -> VCF"""
    input:
        f"{OUT}/{{chrom}}.augref.gbz",
    output:
        vcf=f"{OUT}/{{chrom}}.vcf.gz",
        tbi=f"{OUT}/{{chrom}}.vcf.gz.tbi",
    threads: 8
    resources:
        mem_mb=64000,
        runtime=960,
    shell:
        "vg deconstruct {input} -P {AUGREF} -a -t {threads}"
        " | bgzip > {output.vcf}"
        " && tabix -fp vcf {output.vcf}"


rule fasta:
    """GBZ -> augref reference FASTA"""
    input:
        f"{OUT}/{{chrom}}.augref.gbz",
    output:
        fa=f"{OUT}/{{chrom}}.fa.gz",
        fai=f"{OUT}/{{chrom}}.fa.gz.fai",
        gzi=f"{OUT}/{{chrom}}.fa.gz.gzi",
    threads: 8
    resources:
        mem_mb=32000,
        runtime=480,
    shell:
        "{SCRIPTS}/fasta.sh"
        " --gbz {input}"
        " --ref {AUGREF}"
        " --out-dir {OUT}"
        " --out-name {wildcards.chrom}.fa.gz"
        f" --cpus {{threads}} --mem {MEM_GB}gb"
        " --local"


rule annotate_tr:
    """Annotate indels with tandem repeat motifs"""
    input:
        vcf=f"{OUT}/{{chrom}}.vcf.gz",
        ref=f"{OUT}/{{chrom}}.fa.gz",
    output:
        f"{OUT}/{{chrom}}.tr.vcf.gz",
    resources:
        mem_mb=32000,
        runtime=480,
    shell:
        "python3 {SCRIPTS}/annotate-tr.py"
        " --vcf {input.vcf} --ref {input.ref}"
        " -o {output}"
        " && tabix -fp vcf {output}"


# --- Deconstruct stats ---

rule extract_records:
    """Per-chromosome VCF -> compact per-record TSV (streaming, no mmap)"""
    input:
        f"{OUT}/{{chrom}}.tr.vcf.gz",
    output:
        f"{OUT}/{{chrom}}.sites.records.tsv",
    resources:
        mem_mb=8000,
        runtime=480,
    shell:
        "python3 {SCRIPTS}/vcf-extract-stats.py {input} > {output}"


rule vcf_stats_per_chrom:
    """Per-chromosome records + VCF -> variant stats + per-sample + plots"""
    input:
        vcf=f"{OUT}/{{chrom}}.tr.vcf.gz",
        records=f"{OUT}/{{chrom}}.sites.records.tsv",
        segs=f"{OUT}/{{chrom}}.augref-segs.tsv",
    output:
        tsv=f"{OUT}/{{chrom}}.sites.vcf-stats.tsv",
        types=f"{OUT}/{{chrom}}.sites.variant-types.png",
        af=f"{OUT}/{{chrom}}.sites.af-spectrum.png",
        size_dist=f"{OUT}/{{chrom}}.sites.size-dist.png",
        size_dist_log=f"{OUT}/{{chrom}}.sites.size-dist-log.png",
        per_sample=f"{OUT}/{{chrom}}.sites.per-sample-types.png",
        per_sample_tsv=f"{OUT}/{{chrom}}.sites.per-sample-types.tsv",
    resources:
        mem_mb=128000,
        runtime=960,
    shell:
        "Rscript vcf-stats.R"
        " {input.records} {OUT}/{wildcards.chrom}.sites"
        " --tsv --mode sites --af-step 0.05"
        " --title '{REF} {wildcards.chrom} Deconstruct'"
        " --segs {input.segs}"
        " --per-sample --per-sample-vcf {input.vcf}"
        " --ref-sample {REF}"


rule concat_records:
    """Concatenate per-chromosome per-record TSVs"""
    input:
        expand(f"{OUT}/{{c}}.sites.records.tsv", c=CHROMS),
    output:
        f"{OUT}/all.sites.records.tsv",
    shell:
        "head -1 {input[0]} > {output}"
        " && tail -n +2 -q {input} >> {output}"


rule vcf_stats_aggregate:
    """Aggregated records -> same plots as single-chrom vcf-stats"""
    input:
        records=f"{OUT}/all.sites.records.tsv",
        segs=f"{OUT}/all.augref-segs.tsv",
    resources:
        mem_mb=64000,
        runtime=480,
    output:
        tsv=f"{OUT}/all.sites.vcf-stats.tsv",
        types=f"{OUT}/all.sites.variant-types.png",
        af=f"{OUT}/all.sites.af-spectrum.png",
        size_dist=f"{OUT}/all.sites.size-dist.png",
        size_dist_log=f"{OUT}/all.sites.size-dist-log.png",
    shell:
        "Rscript vcf-stats.R"
        " {input.records} {OUT}/all.sites"
        " --tsv --mode sites --af-step 0.05"
        " --title '{REF} Deconstruct (All Chromosomes)'"
        " --segs {input.segs}"
        " --ref-sample {REF}"


rule per_sample_aggregate:
    """Combine per-chromosome per-sample TSVs into aggregate per-sample plot"""
    input:
        expand(f"{OUT}/{{c}}.sites.per-sample-types.tsv", c=CHROMS),
    output:
        f"{OUT}/all.sites.per-sample-types.png",
    params:
        labeled=lambda wc, input: " ".join(
            f"{os.path.basename(f).replace('.sites.per-sample-types.tsv', '')}:{f}"
            for f in input
        ),
    shell:
        "Rscript {SCRIPTS}/vcf-stats-combine.R"
        " {OUT}/all.per-sample-tmp"
        " --per-sample {params.labeled}"
        " && mv {OUT}/all.per-sample-tmp.per-sample-types.png {output}"
        " && rm -f {OUT}/all.per-sample-tmp.*"


rule summary_deconstruct:
    """Compose aggregate deconstruct summary (figure 2)"""
    input:
        types=f"{OUT}/all.sites.variant-types.png",
        sizedist=f"{OUT}/all.sites.size-dist-log.png",
        af=f"{OUT}/all.sites.af-spectrum.png",
        per_sample=f"{OUT}/all.sites.per-sample-types.png",
    output:
        f"{OUT}/2.deconstruct-summary.png",
    shell:
        "python3 {SCRIPTS}/compose-summary.py"
        " --output {output}"
        " --title 'Deconstruct Variant Catalog (All Chromosomes)'"
        " --cols 2"
        " --panels"
        " 'Variant Types:{input.types}'"
        " 'Size Distribution:{input.sizedist}'"
        " 'AF Spectrum:{input.af}'"
        " 'Per-Sample Types:{input.per_sample}'"


# --- Per-chromosome deconstruct breakdown (Panel 3) ---

rule deconstruct_by_chrom:
    """Per-chromosome breakdown plots (variant counts, AF, per-sample)"""
    resources:
        mem_mb=64000,
        runtime=480,
    input:
        stats=expand(f"{OUT}/{{c}}.sites.vcf-stats.tsv", c=CHROMS),
        per_sample=expand(f"{OUT}/{{c}}.sites.per-sample-types.tsv", c=CHROMS),
        records=expand(f"{OUT}/{{c}}.sites.records.tsv", c=CHROMS),
    output:
        snp_counts=f"{OUT}/all.by-chrom.snp-counts.png",
        indel_counts=f"{OUT}/all.by-chrom.indel-counts.png",
        sv_counts=f"{OUT}/all.by-chrom.sv-counts.png",
        af=f"{OUT}/all.by-chrom.af-spectrum.png",
        ps_snp=f"{OUT}/all.by-chrom.per-sample-snp.png",
        ps_indel=f"{OUT}/all.by-chrom.per-sample-indel.png",
        ps_sv=f"{OUT}/all.by-chrom.per-sample-sv.png",
    params:
        stats_labeled=lambda wc, input: " ".join(
            f"{os.path.basename(f).replace('.sites.vcf-stats.tsv', '')}:{f}"
            for f in input.stats
        ),
        ps_labeled=lambda wc, input: " ".join(
            f"{os.path.basename(f).replace('.sites.per-sample-types.tsv', '')}:{f}"
            for f in input.per_sample
        ),
        rec_labeled=lambda wc, input: " ".join(
            f"{os.path.basename(f).replace('.sites.records.tsv', '')}:{f}"
            for f in input.records
        ),
    shell:
        "Rscript {SCRIPTS}/vcf-stats-by-chrom.R"
        " {OUT}/all.by-chrom"
        " --stats {params.stats_labeled}"
        " --per-sample {params.ps_labeled}"
        " --records {params.rec_labeled}"


rule summary_deconstruct_by_chrom:
    """Compose per-chromosome variant counts + AF (figure 3)"""
    input:
        snp=f"{OUT}/all.by-chrom.snp-counts.png",
        indel=f"{OUT}/all.by-chrom.indel-counts.png",
        sv=f"{OUT}/all.by-chrom.sv-counts.png",
        af=f"{OUT}/all.by-chrom.af-spectrum.png",
    output:
        f"{OUT}/3.deconstruct-by-chrom.png",
    shell:
        "python3 {SCRIPTS}/compose-summary.py"
        " --output {output}"
        " --title 'Deconstruct by Chromosome'"
        " --cols 2"
        " --panels"
        " 'SNP Counts:{input.snp}'"
        " 'MNP / Indel Counts:{input.indel}'"
        " 'SV Counts:{input.sv}'"
        " 'AF Spectrum:{input.af}'"


rule summary_per_sample_by_chrom:
    """Compose per-sample by chromosome (figure 4)"""
    input:
        snp=f"{OUT}/all.by-chrom.per-sample-snp.png",
        indel=f"{OUT}/all.by-chrom.per-sample-indel.png",
        sv=f"{OUT}/all.by-chrom.per-sample-sv.png",
    output:
        f"{OUT}/4.per-sample-by-chrom.png",
    shell:
        "python3 {SCRIPTS}/compose-summary.py"
        " --output {output}"
        " --title 'Per-Sample Counts by Chromosome'"
        " --cols 2"
        " --panels"
        " ' :{input.snp}'"
        " ' :{input.indel}'"
        " ' :{input.sv}'"


# =========================================================================
# Mapping, calling, and DeepVariant (requires reads)
# =========================================================================

if HAS_READS:

    rule haplotypes:
        """GBZ -> haplotype index for giraffe"""
        input:
            f"{OUT}/{{chrom}}.augref.gbz",
        output:
            f"{OUT}/{{chrom}}.hapl",
        threads: 8
        resources:
            mem_mb=256000,
            runtime=960,
        shell:
            "{SCRIPTS}/haplotypes.sh"
            " --gbz {input}"
            " --ref {REF}"
            " --out-dir {OUT}"
            " --out-name {wildcards.chrom}.hapl"
            f" --cpus {{threads}} --mem {MEM_GB}gb"
            " --local"


    rule concat_reads:
        """Concatenate per-haplotype fastqs into one per-sample fastq"""
        input:
            lambda wc: CHROM_SAMPLES.get(wc.chrom, {}).get(wc.sample, []),
        output:
            f"{OUT}/{{chrom}}.{{sample}}.fastq.gz",
        wildcard_constraints:
            sample="|".join(ALL_SAMPLES),
        shell:
            "cat {input} > {output}"


    def giraffe_input(wildcards):
        d = {
            "gbz": f"{OUT}/{wildcards.chrom}.augref.gbz",
            "reads": f"{OUT}/{wildcards.chrom}.{wildcards.sample}.fastq.gz",
            "reads_idx": f"{OUT}/{wildcards.chrom}.{wildcards.sample}.reads.idx",
        }
        if wildcards.chrom not in SKIP_HAPL:
            d["hapl"] = f"{OUT}/{wildcards.chrom}.hapl"
        return d


    rule reads_idx:
        """Create reads index file for giraffe.sh"""
        input:
            f"{OUT}/{{chrom}}.{{sample}}.fastq.gz",
        output:
            f"{OUT}/{{chrom}}.{{sample}}.reads.idx",
        run:
            with open(output[0], "w") as f:
                f.write(os.path.abspath(input[0]) + "\n")


    rule giraffe:
        """GBZ + reads -> GAM (HiFi long reads)"""
        input:
            unpack(giraffe_input),
        output:
            f"{OUT}/{{chrom}}.{{sample}}.gam",
        threads: 8
        resources:
            mem_mb=256000,
            runtime=960,
        run:
            if wildcards.chrom in SKIP_HAPL:
                shell(
                    "vg giraffe -p -t {threads} -b hifi"
                    " -Z {input.gbz}"
                    " -N {wildcards.sample}"
                    " -f {input.reads}"
                    " > {output}")
            else:
                shell(
                    "{SCRIPTS}/giraffe.sh"
                    " --gbz {input.gbz}"
                    " --hapl {input.hapl}"
                    " --reads {input.reads_idx}"
                    " --sample {wildcards.sample}"
                    " --out-dir {OUT}"
                    " --out-name {wildcards.chrom}.{wildcards.sample}.gam"
                    " --preset hifi"
                    f" --cpus {{threads}} --mem {MEM_GB}gb"
                    " --local")


    rule call:
        """GAM -> VCF (vg call)"""
        input:
            gbz=f"{OUT}/{{chrom}}.augref.gbz",
            gam=f"{OUT}/{{chrom}}.{{sample}}.gam",
        output:
            vcf=f"{OUT}/{{chrom}}.{{sample}}.call.vcf.gz",
            pack=f"{OUT}/{{chrom}}.{{sample}}.call.pack",
        threads: 8
        resources:
            mem_mb=256000,
            runtime=960,
        shell:
            "{SCRIPTS}/call.sh"
            " --gbz {input.gbz}"
            " --gam {input.gam}"
            " --ref {AUGREF}"
            " --sample {wildcards.sample}"
            " --out-dir {OUT}"
            " --out-name {wildcards.chrom}.{wildcards.sample}.call.vcf.gz"
            f" --cpus {{threads}} --mem {MEM_GB}gb"
            " --local"


    rule surject:
        """GAM -> sorted BAM (long-read mode)"""
        input:
            gbz=f"{OUT}/{{chrom}}.augref.gbz",
            gam=f"{OUT}/{{chrom}}.{{sample}}.gam",
        output:
            f"{OUT}/{{chrom}}.{{sample}}.bam",
        threads: 8
        resources:
            mem_mb=256000,
            runtime=960,
        shell:
            "{SCRIPTS}/surject.sh"
            " --gbz {input.gbz}"
            " --gam {input.gam}"
            " --ref {AUGREF}"
            " --sample {wildcards.sample}"
            " --out-dir {OUT}"
            " --out-name {wildcards.chrom}.{wildcards.sample}.bam"
            " --no-interleaved --read-length long"
            f" --cpus {{threads}} --mem {MEM_GB}gb"
            " --local"


    rule deepvariant:
        """BAM + FASTA -> VCF (DeepVariant PACBIO model)"""
        input:
            bam=f"{OUT}/{{chrom}}.{{sample}}.bam",
            ref=f"{OUT}/{{chrom}}.fa.gz",
        output:
            f"{OUT}/{{chrom}}.{{sample}}.deepvariant.vcf.gz",
        threads: 8
        resources:
            mem_mb=256000,
            runtime=960,
        shell:
            "DV_TMP=$(mktemp -d $PWD/{OUT}/dv_tmp_{wildcards.chrom}_{wildcards.sample}.XXXXXX)"
            " && "
            "{SCRIPTS}/deepvariant.sh"
            " --bam {input.bam}"
            " --ref {input.ref}"
            " --sample {wildcards.sample}"
            " --out-dir {OUT}"
            " --out-name {wildcards.chrom}.{wildcards.sample}.deepvariant.vcf.gz"
            " --model-type PACBIO"
            " --tmpdir $DV_TMP"
            f" --cpus {{threads}} --mem {MEM_GB}gb"
            " --local"
            " ; rm -rf $DV_TMP"


    rule pass_filter_vcf:
        """VCF -> PASS-only VCF"""
        input:
            f"{OUT}/{{chrom}}.{{sample}}.{{caller}}.vcf.gz",
        output:
            f"{OUT}/{{chrom}}.{{sample}}.{{caller}}.pass-only.vcf.gz",
        wildcard_constraints:
            caller="call|deepvariant",
        shell:
            "bcftools view -f PASS '{input}' -Oz -o {output}"
            " && tabix -p vcf {output}"


    rule merge_call_vcfs_per_chrom:
        """Merge PASS-filtered per-sample call VCFs for one chromosome"""
        input:
            lambda wc: [f"{OUT}/{wc.chrom}.{s}.call.pass-only.vcf.gz"
                        for s in sorted(CHROM_SAMPLES[wc.chrom])],
        output:
            f"{OUT}/{{chrom}}.merged.call.vcf.gz",
        wildcard_constraints:
            chrom="|".join(CALL_CHROMS) if CALL_CHROMS else "NONE",
        resources:
            mem_mb=128000,
            runtime=960,
        shell:
            "bcftools merge {input} -Oz"
            " | bcftools +fill-tags -Oz -o {output} -- -t AF,AC,AN"
            " && tabix -p vcf {output}"


    rule merge_dv_vcfs_per_chrom:
        """Merge PASS-filtered per-sample DeepVariant VCFs for one chromosome"""
        input:
            lambda wc: [f"{OUT}/{wc.chrom}.{s}.deepvariant.pass-only.vcf.gz"
                        for s in sorted(CHROM_SAMPLES[wc.chrom])],
        output:
            f"{OUT}/{{chrom}}.merged.deepvariant.vcf.gz",
        wildcard_constraints:
            chrom="|".join(CALL_CHROMS) if CALL_CHROMS else "NONE",
        resources:
            mem_mb=128000,
            runtime=960,
        shell:
            "bcftools merge {input} -Oz"
            " | bcftools +fill-tags -Oz -o {output} -- -t AF,AC,AN"
            " && tabix -p vcf {output}"


    # --- Per-chromosome call/DV stats ---

    rule call_stats_per_chrom:
        """Per-chrom merged call VCF -> stats + plots"""
        input:
            vcf=f"{OUT}/{{chrom}}.merged.call.vcf.gz",
            segs=f"{OUT}/{{chrom}}.augref-segs.tsv",
        output:
            tsv=f"{OUT}/{{chrom}}.call.sites.pass.vcf-stats.tsv",
            types=f"{OUT}/{{chrom}}.call.sites.pass.variant-types.png",
            size_dist=f"{OUT}/{{chrom}}.call.sites.pass.size-dist.png",
            size_dist_log=f"{OUT}/{{chrom}}.call.sites.pass.size-dist-log.png",
            af=f"{OUT}/{{chrom}}.call.sites.pass.af-spectrum.png",
            per_sample=f"{OUT}/{{chrom}}.call.sites.pass.per-sample-types.png",
            per_sample_tsv=f"{OUT}/{{chrom}}.call.sites.pass.per-sample-types.tsv",
        resources:
            mem_mb=32000,
            runtime=480,
        shell:
            "Rscript vcf-stats.R"
            " {input.vcf} {OUT}/{wildcards.chrom}.call.sites.pass"
            " --mode sites --af-step 0.05"
            " --title '{REF} {wildcards.chrom} Call'"
            " --segs {input.segs} --segs-strip-prefix '{AUGREF}#0#'"
            " --per-sample"


    rule dv_stats_per_chrom:
        """Per-chrom merged DV VCF -> stats + plots"""
        input:

        f"{OUT}/{{chrom}}.tr.vcf.gz",
    output:
        f"{OUT}/{{chrom}}.sites.per-haplotype-types.tsv",
    resources:
        mem_mb=32000,
        runtime=960,
    shell:
        "python3 {SCRIPTS}/vcf-per-haplotype-stats.py {input} > {output}"


rule deconstruct_by_chrom_haplotype:
    """Per-chromosome haplotype breakdown plots"""
    resources:
        mem_mb=64000,
        runtime=960,
    input:
        per_hap=expand(f"{OUT}/{{c}}.sites.per-haplotype-types.tsv", c=CHROMS),
    output:
        ps_snp=f"{OUT}/all.hap.per-sample-snp.png",
        ps_indel=f"{OUT}/all.hap.per-sample-indel.png",
        ps_sv=f"{OUT}/all.hap.per-sample-sv.png",
        ps_snp_onref=f"{OUT}/all.hap.per-sample-snp-onref.png",
        ps_indel_onref=f"{OUT}/all.hap.per-sample-indel-onref.png",
        ps_sv_onref=f"{OUT}/all.hap.per-sample-sv-onref.png",
        ps_snp_combined=f"{OUT}/all.hap.per-sample-snp-combined.png",
        ps_indel_combined=f"{OUT}/all.hap.per-sample-indel-combined.png",
        ps_sv_combined=f"{OUT}/all.hap.per-sample-sv-combined.png",
    params:
        ps_labeled=lambda wc, input: " ".join(
            f"{os.path.basename(f).replace('.sites.per-haplotype-types.tsv', '')}:{f}"
            for f in input.per_hap
        ),
    shell:
        "{RSCRIPT} {SCRIPTS}/vcf-stats-by-chrom.R"
        " {OUT}/all.hap"
        " --per-sample {params.ps_labeled}"


rule concat_per_haplotype_by_chrom:
    """Concatenate per-chrom per-haplotype TSVs with chrom column (4c source data)"""
    input:
        expand(f"{OUT}/{{c}}.sites.per-haplotype-types.tsv", c=CHROMS),
    output:
        f"{OUT}/4c.per-haplotype-by-chrom.tsv",
    run:
        with open(output[0], "w") as out:
            out.write("chrom\tsample\tvariant_type\tref_context\tcount\n")
            for f in input:
                chrom = os.path.basename(f).replace(".sites.per-haplotype-types.tsv", "")
                with open(f) as inp:
                    next(inp)
                    for line in inp:
                        out.write(f"{chrom}\t{line}")


rule summary_per_haplotype_by_chrom_combined:
    """Compose per-haplotype by chromosome, off+on-ref overlaid (figure 4c)"""
    resources:
        mem_mb=32000,
        runtime=960,
    input:
        snp=f"{OUT}/all.hap.per-sample-snp-combined.png",
        indel=f"{OUT}/all.hap.per-sample-indel-combined.png",
        sv=f"{OUT}/all.hap.per-sample-sv-combined.png",
    output:
        f"{OUT}/4c.per-haplotype-by-chrom-combined.png",
    shell:
        "python3 {SCRIPTS}/compose-summary.py"
        " --output {output}"
        " --title 'Deconstruct Per-Haplotype Counts by Chromosome (off- + on-ref)'"
        " --cols 1"
        " --panels"
        " ' :{input.snp}'"
        " ' :{input.indel}'"
        " ' :{input.sv}'"


# =========================================================================
# Mapping, calling, and DeepVariant (requires reads)
# =========================================================================

if HAS_READS:

    rule haplotypes:
        """GBZ -> haplotype index for giraffe"""
        input:
            f"{OUT}/{{chrom}}.augref.gbz",
        output:
            f"{OUT}/{{chrom}}.hapl",
        threads: 4
        resources:
            mem_mb=64000,
            runtime=960,
        shell:
            "{SCRIPTS}/haplotypes.sh"
            " --gbz {input}"
            " --ref {REF}"
            " --out-dir {OUT}"
            " --out-name {wildcards.chrom}.hapl"
            " --haplotypes-opts '--preset diploid'"
            f" --cpus {{threads}} --mem {MEM_GB}gb"
            " --local"


    rule concat_reads:
        """Concatenate per-haplotype fastqs into one per-sample fastq"""
        resources:
            mem_mb=32000,
            runtime=960,
        input:
            lambda wc: CHROM_SAMPLES.get(wc.chrom, {}).get(wc.sample, []),
        output:
            f"{OUT}/{{chrom}}.{{sample}}.fastq.gz",
        wildcard_constraints:
            sample="|".join(ALL_SAMPLES),
        shell:
            "cat {input} > {output}"


    def giraffe_input(wildcards):
        d = {
            "gbz": f"{OUT}/{wildcards.chrom}.augref.gbz",
            "reads": f"{OUT}/{wildcards.chrom}.{wildcards.sample}.fastq.gz",
            "reads_idx": f"{OUT}/{wildcards.chrom}.{wildcards.sample}.reads.idx",
        }
        if wildcards.chrom not in SKIP_HAPL:
            d["hapl"] = f"{OUT}/{wildcards.chrom}.hapl"
        return d


    rule reads_idx:
        """Create reads index file for giraffe.sh"""
        resources:
            mem_mb=32000,
            runtime=960,
        input:
            f"{OUT}/{{chrom}}.{{sample}}.fastq.gz",
        output:
            f"{OUT}/{{chrom}}.{{sample}}.reads.idx",
        run:
            with open(output[0], "w") as f:
                f.write(os.path.abspath(input[0]) + "\n")


    rule giraffe:
        """GBZ + reads -> GAM (HiFi long reads)"""
        input:
            unpack(giraffe_input),
        output:
            f"{OUT}/{{chrom}}.{{sample}}.gam",
        threads: 4
        resources:
            mem_mb=64000,
            runtime=960,
        run:
            if wildcards.chrom in SKIP_HAPL:
                shell(
                    "vg giraffe -p -t {threads} -b hifi"
                    " -Z {input.gbz}"
                    " -N {wildcards.sample}"
                    " -f {input.reads}"
                    " > {output}")
            else:
                shell(
                    "{SCRIPTS}/giraffe.sh"
                    " --gbz {input.gbz}"
                    " --hapl {input.hapl}"
                    " --reads {input.reads_idx}"
                    " --sample {wildcards.sample}"
                    " --out-dir {OUT}"
                    " --out-name {wildcards.chrom}.{wildcards.sample}.gam"
                    " --preset hifi"
                    f" --cpus {{threads}} --mem {MEM_GB}gb"
                    " --local")


    rule call:
        """GAM -> VCF (vg call)"""
        input:
            gbz=f"{OUT}/{{chrom}}.augref.gbz",
            gam=f"{OUT}/{{chrom}}.{{sample}}.gam",
        output:
            vcf=f"{OUT}/{{chrom}}.{{sample}}.call.vcf.gz",
            pack=f"{OUT}/{{chrom}}.{{sample}}.call.pack",
        threads: 4
        resources:
            mem_mb=64000,
            runtime=960,
        shell:
            "{SCRIPTS}/call.sh"
            " --gbz {input.gbz}"
            " --gam {input.gam}"
            " --ref {AUGREF}"
            " --sample {wildcards.sample}"
            " --out-dir {OUT}"
            " --out-name {wildcards.chrom}.{wildcards.sample}.call.vcf.gz"
            f" --cpus {{threads}} --mem {MEM_GB}gb"
            " --local"


    rule surject:
        """GAM -> sorted BAM (long-read mode)"""
        input:
            gbz=f"{OUT}/{{chrom}}.augref.gbz",
            gam=f"{OUT}/{{chrom}}.{{sample}}.gam",
        output:
            f"{OUT}/{{chrom}}.{{sample}}.bam",
        threads: 4
        resources:
            mem_mb=64000,
            runtime=960,
        shell:
            "{SCRIPTS}/surject.sh"
            " --gbz {input.gbz}"
            " --gam {input.gam}"
            " --ref {AUGREF}"
            " --sample {wildcards.sample}"
            " --out-dir {OUT}"
            " --out-name {wildcards.chrom}.{wildcards.sample}.bam"
            " --no-interleaved --read-length long"
            f" --cpus {{threads}} --mem {MEM_GB}gb"
            " --local"


    rule deepvariant:
        """BAM + FASTA -> VCF (DeepVariant PACBIO model)"""
        input:
            bam=f"{OUT}/{{chrom}}.{{sample}}.bam",
            ref=f"{OUT}/{{chrom}}.fa.gz",
        output:
            f"{OUT}/{{chrom}}.{{sample}}.deepvariant.vcf.gz",
        threads: 4
        resources:
            mem_mb=64000,
            runtime=960,
        shell:
            "DV_TMP=$(mktemp -d $PWD/{OUT}/dv_tmp_{wildcards.chrom}_{wildcards.sample}.XXXXXX)"
            " && "
            "{SCRIPTS}/deepvariant.sh"
            " --bam {input.bam}"
            " --ref {input.ref}"
            " --sample {wildcards.sample}"
            " --out-dir {OUT}"
            " --out-name {wildcards.chrom}.{wildcards.sample}.deepvariant.vcf.gz"
            " --model-type PACBIO"
            " --tmpdir $DV_TMP"
            f" --cpus {{threads}} --mem {MEM_GB}gb"
            " --local"
            " ; rm -rf $DV_TMP"


    rule pass_filter_vcf:
        """VCF -> PASS-only VCF"""
        resources:
            mem_mb=32000,
            runtime=960,
        input:
            f"{OUT}/{{chrom}}.{{sample}}.{{caller}}.vcf.gz",
        output:
            f"{OUT}/{{chrom}}.{{sample}}.{{caller}}.pass-only.vcf.gz",
        wildcard_constraints:
            caller="call|deepvariant",
        shell:
            "bcftools view -f PASS '{input}' -Oz -o {output}"
            " && tabix -p vcf {output}"


    rule merge_call_vcfs_per_chrom:
        """Merge PASS-filtered per-sample call VCFs for one chromosome"""
        input:
            lambda wc: [f"{OUT}/{wc.chrom}.{s}.call.pass-only.vcf.gz"
                        for s in sorted(CHROM_SAMPLES[wc.chrom])],
        output:
            f"{OUT}/{{chrom}}.merged.call.vcf.gz",
        wildcard_constraints:
            chrom="|".join(CALL_CHROMS) if CALL_CHROMS else "NONE",
        resources:
            mem_mb=128000,
            runtime=960,
        shell:
            "bcftools merge {input} -Oz"
            " | bcftools +fill-tags -Oz -o {output} -- -t AF,AC,AN"
            " && tabix -p vcf {output}"


    rule merge_dv_vcfs_per_chrom:
        """Merge PASS-filtered per-sample DeepVariant VCFs for one chromosome"""
        input:
            lambda wc: [f"{OUT}/{wc.chrom}.{s}.deepvariant.pass-only.vcf.gz"
                        for s in sorted(CHROM_SAMPLES[wc.chrom])],
        output:
            f"{OUT}/{{chrom}}.merged.deepvariant.vcf.gz",
        wildcard_constraints:
            chrom="|".join(CALL_CHROMS) if CALL_CHROMS else "NONE",
        resources:
            mem_mb=128000,
            runtime=960,
        shell:
            "bcftools merge {input} -Oz"
            " | bcftools +fill-tags -Oz -o {output} -- -t AF,AC,AN"
            " && tabix -p vcf {output}"


    # --- Per-chromosome call/DV stats ---

    rule call_stats_per_chrom:
        """Per-chrom merged call VCF -> stats + plots"""
        input:
            vcf=f"{OUT}/{{chrom}}.merged.call.vcf.gz",
            segs=f"{OUT}/{{chrom}}.augref-segs.tsv",
        output:
            tsv=f"{OUT}/{{chrom}}.call.sites.pass.vcf-stats.tsv",
            types=f"{OUT}/{{chrom}}.call.sites.pass.variant-types.png",
            size_dist=f"{OUT}/{{chrom}}.call.sites.pass.size-dist.png",
            size_dist_log=f"{OUT}/{{chrom}}.call.sites.pass.size-dist-log.png",
            af=f"{OUT}/{{chrom}}.call.sites.pass.af-spectrum.png",
            per_sample=f"{OUT}/{{chrom}}.call.sites.pass.per-sample-types.png",
            per_sample_tsv=f"{OUT}/{{chrom}}.call.sites.pass.per-sample-types.tsv",
        resources:
            mem_mb=32000,
            runtime=960,
        shell:
            "{RSCRIPT} vcf-stats.R"
            " {input.vcf} {OUT}/{wildcards.chrom}.call.sites.pass"
            " --mode sites --af-step 0.05"
            " --title '{REF} {wildcards.chrom} Call'"
            " --segs {input.segs} --segs-strip-prefix '{AUGREF}#0#'"
            " --per-sample"


    rule dv_stats_per_chrom:
        """Per-chrom merged DV VCF -> stats + plots"""
        input:
            vcf=f"{OUT}/{{chrom}}.merged.deepvariant.vcf.gz",
            segs=f"{OUT}/{{chrom}}.augref-segs.tsv",
        output:
            tsv=f"{OUT}/{{chrom}}.dv.sites.pass.vcf-stats.tsv",
            types=f"{OUT}/{{chrom}}.dv.sites.pass.variant-types.png",
            size_dist=f"{OUT}/{{chrom}}.dv.sites.pass.size-dist.png",
            size_dist_log=f"{OUT}/{{chrom}}.dv.sites.pass.size-dist-log.png",
            af=f"{OUT}/{{chrom}}.dv.sites.pass.af-spectrum.png",
            per_sample=f"{OUT}/{{chrom}}.dv.sites.pass.per-sample-types.png",
            per_sample_tsv=f"{OUT}/{{chrom}}.dv.sites.pass.per-sample-types.tsv",
        resources:
            mem_mb=32000,
            runtime=960,
        shell:
            "{RSCRIPT} vcf-stats.R"
            " {input.vcf} {OUT}/{wildcards.chrom}.dv.sites.pass"
            " --mode sites --af-step 0.05"
            " --title '{REF} {wildcards.chrom} DeepVariant'"
            " --segs {input.segs}"
            " --per-sample"



        """Per-chrom merged DV VCF -> compact records TSV"""
        input:
            f"{OUT}/{{chrom}}.merged.deepvariant.vcf.gz",
        output:
            f"{OUT}/{{chrom}}.dv.sites.pass.records.tsv",

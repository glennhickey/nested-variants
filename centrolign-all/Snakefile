    # --- Aggregate call/DV across chromosomes ---

    rule concat_call_vcfs:
        """Concatenate per-chrom merged call VCFs (subset to common samples)"""
        input:
            expand(f"{OUT}/{{c}}.merged.call.vcf.gz", c=CALL_CHROMS),
        output:
            f"{OUT}/all.merged.call.vcf.gz",
        params:
            samples=",".join(COMMON_SAMPLES),
        shell:
            "TMPDIR=$(mktemp -d) && "
            "for f in {input}; do "
            "  bcftools view -s '{params.samples}' $f -Oz"
            "  -o $TMPDIR/$(basename $f)"
            "  && tabix -fp vcf $TMPDIR/$(basename $f); "
            "done && "
            "bcftools concat -a $TMPDIR/*.vcf.gz -Oz -o {output}"
            " && tabix -fp vcf {output}"
            " && rm -rf $TMPDIR"


    rule concat_dv_vcfs:
        """Concatenate per-chrom merged DV VCFs (subset to common samples)"""
        input:
            expand(f"{OUT}/{{c}}.merged.deepvariant.vcf.gz", c=CALL_CHROMS),
        output:
            f"{OUT}/all.merged.deepvariant.vcf.gz",
        params:
            samples=",".join(COMMON_SAMPLES),
        shell:
            "TMPDIR=$(mktemp -d) && "
            "for f in {input}; do "
            "  bcftools view -s '{params.samples}' $f -Oz"
            "  -o $TMPDIR/$(basename $f)"
            "  && tabix -fp vcf $TMPDIR/$(basename $f); "
            "done && "
            "bcftools concat -a $TMPDIR/*.vcf.gz -Oz -o {output}"
            " && tabix -fp vcf {output}"
            " && rm -rf $TMPDIR"


    rule call_stats_aggregate:

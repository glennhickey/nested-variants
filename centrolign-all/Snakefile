            f"{OUT}/6c.call-per-sample-by-chrom-combined.png",
        shell:
            "python3 {SCRIPTS}/compose-summary.py"
            " --output {output}"
            " --title 'vg call Per-Sample by Chromosome (off- + on-ref)'"
            " --cols 1"
            " --panels"
            " ' :{input.snp}'"
            " ' :{input.indel}'"
            " ' :{input.sv}'"


    # --- Per-haplotype variants (vg call) ---

    rule call_per_haplotype_per_chrom:
        """Per-chromosome merged call VCF -> per-haplotype variant counts"""
        input:
            f"{OUT}/{{chrom}}.merged.call.vcf.gz",
        output:
            f"{OUT}/{{chrom}}.call.sites.pass.per-haplotype-types.tsv",
        resources:
            mem_mb=32000,
            runtime=960,
        shell:
            "python3 {SCRIPTS}/vcf-per-haplotype-stats.py {input} > {output}"


    rule call_by_chrom_haplotype:
        """Per-chromosome call haplotype breakdown plots"""
        resources:
            mem_mb=64000,
            runtime=960,
        input:
            per_hap=expand(f"{OUT}/{{c}}.call.sites.pass.per-haplotype-types.tsv", c=CALL_CHROMS),
        output:
            ps_snp=f"{OUT}/all.call.hap.per-sample-snp.png",
            ps_indel=f"{OUT}/all.call.hap.per-sample-indel.png",
            ps_sv=f"{OUT}/all.call.hap.per-sample-sv.png",
            ps_snp_onref=f"{OUT}/all.call.hap.per-sample-snp-onref.png",
            ps_indel_onref=f"{OUT}/all.call.hap.per-sample-indel-onref.png",
            ps_sv_onref=f"{OUT}/all.call.hap.per-sample-sv-onref.png",
            ps_snp_combined=f"{OUT}/all.call.hap.per-sample-snp-combined.png",
            ps_indel_combined=f"{OUT}/all.call.hap.per-sample-indel-combined.png",
            ps_sv_combined=f"{OUT}/all.call.hap.per-sample-sv-combined.png",
        params:
            ps_labeled=lambda wc, input: " ".join(
                f"{os.path.basename(f).replace('.call.sites.pass.per-haplotype-types.tsv', '')}:{f}"
                for f in input.per_hap),
        shell:
            "{RSCRIPT} {SCRIPTS}/vcf-stats-by-chrom.R"
            " {OUT}/all.call.hap"
            " --per-sample {params.ps_labeled}"


    rule concat_call_per_haplotype_by_chrom:
        """Concatenate per-chrom call per-haplotype TSVs with chrom column (6d source data)"""
        input:
            expand(f"{OUT}/{{c}}.call.sites.pass.per-haplotype-types.tsv", c=CALL_CHROMS),

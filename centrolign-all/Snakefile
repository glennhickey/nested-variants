# Snakefile — multi-chromosome centromere augref analysis
#
# Discovers *.gbz files in the working directory and runs the augref +
# deconstruct pipeline on each, then aggregates results into summary figures.
#
# Usage:
#   source ../venv-nested-variants/bin/activate
#   snakemake --cores 8 -np   # dry run
#   snakemake --cores 8        # full run

import os
import sys
import glob as _glob

SCRIPTS = "../scripts"
REF = config.get("ref", "CHM13")
AUGREF = f"augref_{REF}"
OUT = config.get("out", "../output/centrolign-all")
MIN_AUGREF_LEN = config.get("min_augref_len", 50)
READS_DIR = config.get("reads_dir", "reads")
SKIP_HAPL = set(config.get("skip_hapl", "").split(",")) - {""}
# Memory cap passed to scripts (KMC, DV). On cluster, 256 GB; for local
# testing, override with --config mem_gb=16
MEM_GB = int(config.get("mem_gb", 256))
# Skip DeepVariant panels (7, 8, 8b). BAMs from surject are still produced
# if requested as targets. Set via --config skip_dv=True
SKIP_DV = str(config.get("skip_dv", False)).lower() in ("true", "1", "yes")

# Also emit vector PDF versions of every plot (next to the .png).
# Set via --config emit_svg=True.  Uses cairo_pdf which works on headless
# SLURM nodes (grDevices::svg does not).
_EMIT_SVG = str(config.get("emit_svg", False)).lower() in ("true", "1", "yes")
RSCRIPT = "EMIT_SVG=1 Rscript" if _EMIT_SVG else "Rscript"

# Auto-discover input graphs: either *.gbz or *.gfa (e.g. chrY.centrolign.HPRC_r2_QCv2.gfa).
# Chromosome is the first dot-separated field. Build CHROM_INPUT map.
CHROM_INPUT = {}
for f in sorted(_glob.glob("*.gbz") + _glob.glob("*.gfa")):
    if ".giraffe." in f:
        continue
    chrom = os.path.basename(f).split(".")[0]
    if not chrom.startswith("chr"):
        continue
    # Prefer .gbz over .gfa if both exist for the same chrom
    if chrom in CHROM_INPUT and CHROM_INPUT[chrom].endswith(".gbz"):
        continue
    CHROM_INPUT[chrom] = f

# Chromosomes: specify via --config chroms="chr6,chr12" or auto-discover
if "chroms" in config:
    CHROMS = config["chroms"].split(",")
else:
    CHROMS = sorted(
        list(CHROM_INPUT.keys()),
        key=lambda c: (len(c), c),
    )


# Auto-discover read samples from the reads directory. Supports two layouts:
#   1. Flat:     {reads_dir}/{chrom}.{sample}.{hap}.real.fastq[.gz]
#   2. Per-chrom: {reads_dir}/{chrom}/{sample}.{hap}_{chrom}_asat.fastq[.gz]
# Builds CHROM_SAMPLE_HAPS[chrom][sample] = {hap: fastq_path} (intermediate),
# then filters to diploid samples (both .1 and .2 present) and stores as
# CHROM_SAMPLES[chrom][sample] = [hap1_fastq, hap2_fastq].
import re as _re
CHROM_SAMPLE_HAPS = {}

# Layout 1: flat — {chrom}.{sample}.{hap}.real.fastq[.gz]
_flat_pat = _re.compile(r"^(chr[^.]+)\.([^.]+)\.(\d+)\.real\.fastq(\.gz)?$")
for fq in sorted(_glob.glob(f"{READS_DIR}/*.real.fastq*")):
    m = _flat_pat.match(os.path.basename(fq))
    if not m:
        continue
    chrom, sample, hap = m.group(1), m.group(2), m.group(3)
    if chrom in CHROMS:
        CHROM_SAMPLE_HAPS.setdefault(chrom, {}).setdefault(sample, {})[hap] = os.path.abspath(fq)

# Layout 2: per-chrom subdirs — {chrom}/{sample}.{hap}_{chrom}_asat.fastq[.gz]
_nested_pat = _re.compile(r"^([^.]+)\.(\d+)_(chr[^_]+)_.*\.fastq(\.gz)?$")
for chrom_dir in sorted(_glob.glob(f"{READS_DIR}/chr*")):
    if not os.path.isdir(chrom_dir):
        continue
    chrom = os.path.basename(chrom_dir)
    if chrom not in CHROMS:
        continue
    for fq in sorted(_glob.glob(f"{chrom_dir}/*.fastq*")):
        m = _nested_pat.match(os.path.basename(fq))
        if not m:
            continue
        sample, hap = m.group(1), m.group(2)
        CHROM_SAMPLE_HAPS.setdefault(chrom, {}).setdefault(sample, {})[hap] = os.path.abspath(fq)

# Keep only diploid samples (both .1 and .2 present); order haplotypes as [1, 2]
CHROM_SAMPLES = {}
for chrom, samples in CHROM_SAMPLE_HAPS.items():
    for sample, haps in samples.items():
        if "1" in haps and "2" in haps:
            CHROM_SAMPLES.setdefault(chrom, {})[sample] = [haps["1"], haps["2"]]

# Optional cap: keep at most N samples per chromosome, preferring samples that
# appear in the most chromosomes (so the common-samples intersection stays
# large for aggregate plots).  Tie-break alphabetically for determinism.
MAX_SAMPLES = int(config.get("max_samples_per_chrom", 0))
if MAX_SAMPLES > 0:
    from collections import Counter
    freq = Counter(s for chrom_samples in CHROM_SAMPLES.values()
                     for s in chrom_samples)
    for chrom in list(CHROM_SAMPLES):
        samples = CHROM_SAMPLES[chrom]
        keep = sorted(samples.keys(), key=lambda s: (-freq[s], s))[:MAX_SAMPLES]
        CHROM_SAMPLES[chrom] = {s: samples[s] for s in keep}

# Chromosomes that have both a GBZ and reads
CALL_CHROMS = sorted(
    [c for c in CHROMS if c in CHROM_SAMPLES],
    key=lambda c: (len(c), c),
)
# All unique sample names across chromosomes (union)
ALL_SAMPLES = sorted(set(
    s for c in CALL_CHROMS for s in CHROM_SAMPLES[c]
))
# Samples present in ALL call chromosomes (intersection) — needed for cross-chrom
# concat, which requires identical sample sets across per-chrom merged VCFs.
COMMON_SAMPLES = sorted(
    set.intersection(*(set(CHROM_SAMPLES[c]) for c in CALL_CHROMS))
) if CALL_CHROMS else []

# Whether to produce mapping/calling panels (need reads)
HAS_READS = len(CALL_CHROMS) > 0
# Whether to produce aggregate call/DV panels (need at least one sample in every chrom)
HAS_COMMON_SAMPLES = len(COMMON_SAMPLES) > 0
if HAS_READS and not HAS_COMMON_SAMPLES:
    print(f"WARNING: no sample present in all {len(CALL_CHROMS)} chromosomes; "
          f"skipping aggregate call/DV panels (5, 7). Per-chrom and by-chrom "
          f"panels (6, 8) will still be built.", file=sys.stderr)


wildcard_constraints:
    chrom="chr[0-9XYM]+",


rule all:
    input:
        f"{OUT}/1.augref-summary.png",
        f"{OUT}/2.deconstruct-summary.png",
        f"{OUT}/3.deconstruct-by-chrom.png",
        f"{OUT}/4.per-sample-by-chrom.png",
        f"{OUT}/4b.per-sample-by-chrom-combined.png",
        f"{OUT}/4b.per-sample-by-chrom.tsv",
        f"{OUT}/4c.per-haplotype-by-chrom-combined.png",
        f"{OUT}/4c.per-haplotype-by-chrom.tsv",
        # Call panels (always produced if reads are present)
        *([f"{OUT}/5.call-summary.png",
           f"{OUT}/6.call-by-chrom.png",
           f"{OUT}/6b.call-per-sample-by-chrom.png",
           f"{OUT}/6c.call-per-sample-by-chrom-combined.png",
           f"{OUT}/6c.per-sample-by-chrom.tsv",
           f"{OUT}/6d.call-per-haplotype-by-chrom-combined.png",
           f"{OUT}/6d.per-haplotype-by-chrom.tsv",
          ] if HAS_READS else []),
        # DeepVariant panels (skipped when skip_dv=True)
        *([f"{OUT}/7.deepvariant-summary.png",
           f"{OUT}/8.deepvariant-by-chrom.png",
           f"{OUT}/8b.dv-per-sample-by-chrom.png",
          ] if HAS_READS and not SKIP_DV else []),
        # Per-sample BAMs from surject (kept as standalone targets when
        # DV is skipped, since nothing downstream would otherwise pull them)
        *([f"{OUT}/{c}.{s}.bam"
           for c in CALL_CHROMS for s in sorted(CHROM_SAMPLES[c])]
          if HAS_READS and SKIP_DV else []),


# --- Per-chromosome graph construction ---

rule graph_to_vg:
    """GBZ or GFA -> VG (set RS header so reference path type is preserved)"""
    input:
        lambda wc: CHROM_INPUT[wc.chrom],
    output:
        "{chrom}.vg",
    resources:
        mem_mb=32000,
        runtime=960,
    params:
        pipe_prefix=lambda wc: (
            f"vg convert -f {CHROM_INPUT[wc.chrom]}" if CHROM_INPUT[wc.chrom].endswith(".gbz")
            else f"cat {CHROM_INPUT[wc.chrom]}"
        ),
    shell:
        "{params.pipe_prefix}"
        " | python3 fix-path-names.py --ref {REF} --header-only"
        " | vg convert -g - > {output}"


rule paths:
    """VG -> augref GFA + segment table"""
    input:
        "{chrom}.vg",
    output:
        gfa=f"{OUT}/{{chrom}}.augref.gfa",
        segs=f"{OUT}/{{chrom}}.augref-segs.tsv",
    threads: 8
    resources:
        mem_mb=64000,
        runtime=960,
    shell:
        "vg paths -x {input} -Q {REF} -u"
        " --min-augref-len {MIN_AUGREF_LEN}"
        " --augref-sample {AUGREF}"
        " --augref-segs {output.segs}"
        " -t {threads}"
        " | vg convert -f - > {output.gfa}"


rule gbz:
    """GFA -> GBZ"""
    input:
        f"{OUT}/{{chrom}}.augref.gfa",
    output:
        f"{OUT}/{{chrom}}.augref.gbz",
    resources:
        mem_mb=32000,
        runtime=960,
    shell:
        "vg gbwt -G {input} --gbz-format -g {output}"


# --- Aggregated augref summary (Panel 1) ---

rule length_hist:
    resources:
        mem_mb=32000,
        runtime=960,
    """All augref-segs -> cumulative length histogram"""
    input:
        expand(f"{OUT}/{{c}}.augref-segs.tsv", c=CHROMS),
    output:
        f"{OUT}/all.augref-length-hist.png",
    shell:
        "{RSCRIPT} {SCRIPTS}/offref-length-hist.R {output} {input} TRUE"


rule length_hist_log:
    resources:
        mem_mb=32000,
        runtime=960,
    """All augref-segs -> log-log length histogram"""
    input:
        expand(f"{OUT}/{{c}}.augref-segs.tsv", c=CHROMS),
    output:
        f"{OUT}/all.augref-length-hist-log.png",
    shell:
        "{RSCRIPT} {SCRIPTS}/offref-length-hist.R {output} {input} FALSE"


rule concat_segs:
    resources:
        mem_mb=32000,
        runtime=960,
    """Concatenate per-chromosome augref-segs, rewriting ref_contig to include chrom"""
    input:
        expand(f"{OUT}/{{c}}.augref-segs.tsv", c=CHROMS),
    output:
        f"{OUT}/all.augref-segs.tsv",
    run:
        with open(output[0], "w") as out:
            for f in input:
                chrom = os.path.basename(f).replace(".augref-segs.tsv", "")
                with open(f) as inp:
                    for line in inp:
                        cols = line.rstrip("\n").split("\t")
                        # col 4 (ref_contig): replace CHM13#0#CHM13.0 with CHM13#0#chrom
                        cols[4] = f"{REF}#0#{chrom}"
                        out.write("\t".join(cols) + "\n")


rule segment_density:
    resources:
        mem_mb=32000,
        runtime=960,
    """All augref-segs -> chromosome density ideogram"""
    input:
        f"{OUT}/all.augref-segs.tsv",
    output:
        f"{OUT}/all.offref-segs.png",
    shell:
        "{RSCRIPT} {SCRIPTS}/chrom-density-tsv.R"
        " {input} {output}"
        " '{REF} Off-Reference Segment Density'"
        " {MIN_AUGREF_LEN} '' log1p"


# --- Per-chromosome deconstruction ---

rule deconstruct:
    """GBZ -> VCF"""
    input:
        f"{OUT}/{{chrom}}.augref.gbz",
    output:
        vcf=f"{OUT}/{{chrom}}.vcf.gz",
        tbi=f"{OUT}/{{chrom}}.vcf.gz.tbi",
    threads: 8
    resources:
        mem_mb=64000,
        runtime=960,
    shell:
        "vg deconstruct {input} -P {AUGREF} -a -t {threads}"
        " | bgzip > {output.vcf}"
        " && tabix -fp vcf {output.vcf}"


rule fasta:
    """GBZ -> augref reference FASTA"""
    input:
        f"{OUT}/{{chrom}}.augref.gbz",
    output:
        fa=f"{OUT}/{{chrom}}.fa.gz",
        fai=f"{OUT}/{{chrom}}.fa.gz.fai",
        gzi=f"{OUT}/{{chrom}}.fa.gz.gzi",
    threads: 8
    resources:
        mem_mb=32000,
        runtime=960,
    shell:
        "{SCRIPTS}/fasta.sh"
        " --gbz {input}"
        " --ref {AUGREF}"
        " --out-dir {OUT}"
        " --out-name {wildcards.chrom}.fa.gz"
        f" --cpus {{threads}} --mem {MEM_GB}gb"
        " --local"


rule annotate_tr:
    """Annotate indels with tandem repeat motifs"""
    input:
        vcf=f"{OUT}/{{chrom}}.vcf.gz",
        ref=f"{OUT}/{{chrom}}.fa.gz",
    output:
        f"{OUT}/{{chrom}}.tr.vcf.gz",
    resources:
        mem_mb=32000,
        runtime=960,
    shell:
        "python3 {SCRIPTS}/annotate-tr.py"
        " --vcf {input.vcf} --ref {input.ref}"
        " -o {output}"
        " && tabix -fp vcf {output}"


# --- Deconstruct stats ---

rule extract_records:
    """Per-chromosome VCF -> compact per-record TSV (streaming, no mmap)"""
    input:
        f"{OUT}/{{chrom}}.tr.vcf.gz",
    output:
        f"{OUT}/{{chrom}}.sites.records.tsv",
    resources:
        mem_mb=8000,
        runtime=960,
    shell:
        "python3 {SCRIPTS}/vcf-extract-stats.py {input} > {output}"


rule vcf_stats_per_chrom:
    """Per-chromosome records + VCF -> variant stats + per-sample + plots"""
    input:
        vcf=f"{OUT}/{{chrom}}.tr.vcf.gz",
        records=f"{OUT}/{{chrom}}.sites.records.tsv",
        segs=f"{OUT}/{{chrom}}.augref-segs.tsv",
    output:
        tsv=f"{OUT}/{{chrom}}.sites.vcf-stats.tsv",
        types=f"{OUT}/{{chrom}}.sites.variant-types.png",
        af=f"{OUT}/{{chrom}}.sites.af-spectrum.png",
        size_dist=f"{OUT}/{{chrom}}.sites.size-dist.png",
        size_dist_log=f"{OUT}/{{chrom}}.sites.size-dist-log.png",
        per_sample=f"{OUT}/{{chrom}}.sites.per-sample-types.png",
        per_sample_tsv=f"{OUT}/{{chrom}}.sites.per-sample-types.tsv",
    resources:
        mem_mb=128000,
        runtime=960,
    shell:
        "{RSCRIPT} vcf-stats.R"
        " {input.records} {OUT}/{wildcards.chrom}.sites"
        " --tsv --mode sites --af-step 0.05"
        " --title '{REF} {wildcards.chrom} Deconstruct'"
        " --segs {input.segs}"
        " --per-sample --per-sample-vcf {input.vcf}"
        " --ref-sample {REF}"


rule concat_records:
    resources:
        mem_mb=32000,
        runtime=960,
    """Concatenate per-chromosome per-record TSVs"""
    input:
        expand(f"{OUT}/{{c}}.sites.records.tsv", c=CHROMS),
    output:
        f"{OUT}/all.sites.records.tsv",
    shell:
        "head -1 {input[0]} > {output}"
        " && tail -n +2 -q {input} >> {output}"


rule vcf_stats_aggregate:
    """Aggregated records -> same plots as single-chrom vcf-stats"""
    input:
        records=f"{OUT}/all.sites.records.tsv",
        segs=f"{OUT}/all.augref-segs.tsv",
    resources:
        mem_mb=64000,
        runtime=960,
    output:
        tsv=f"{OUT}/all.sites.vcf-stats.tsv",
        types=f"{OUT}/all.sites.variant-types.png",
        af=f"{OUT}/all.sites.af-spectrum.png",
        size_dist=f"{OUT}/all.sites.size-dist.png",
        size_dist_log=f"{OUT}/all.sites.size-dist-log.png",
    shell:
        "{RSCRIPT} vcf-stats.R"
        " {input.records} {OUT}/all.sites"
        " --tsv --mode sites --af-step 0.05"
        " --title '{REF} Deconstruct (All Chromosomes)'"
        " --segs {input.segs}"
        " --ref-sample {REF}"


rule per_sample_aggregate:
    resources:
        mem_mb=32000,
        runtime=960,
    """Combine per-chromosome per-sample TSVs into aggregate per-sample plot"""
    input:
        expand(f"{OUT}/{{c}}.sites.per-sample-types.tsv", c=CHROMS),
    output:
        f"{OUT}/all.sites.per-sample-types.png",
    params:
        labeled=lambda wc, input: " ".join(
            f"{os.path.basename(f).replace('.sites.per-sample-types.tsv', '')}:{f}"
            for f in input
        ),
    shell:
        "{RSCRIPT} {SCRIPTS}/vcf-stats-combine.R"
        " {OUT}/all.per-sample-tmp"
        " --per-sample {params.labeled}"
        " && mv {OUT}/all.per-sample-tmp.per-sample-types.png {output}"
        " && rm -f {OUT}/all.per-sample-tmp.*"


rule summary_deconstruct:
    resources:
        mem_mb=32000,
        runtime=960,
    """Compose aggregate deconstruct summary (figure 2)"""
    input:
        types=f"{OUT}/all.sites.variant-types.png",
        sizedist=f"{OUT}/all.sites.size-dist-log.png",
        af=f"{OUT}/all.sites.af-spectrum.png",
        per_sample=f"{OUT}/all.sites.per-sample-types.png",
    output:
        f"{OUT}/2.deconstruct-summary.png",
    shell:
        "python3 {SCRIPTS}/compose-summary.py"
        " --output {output}"
        " --title 'Deconstruct Variant Catalog (All Chromosomes)'"
        " --cols 2"
        " --panels"
        " 'Variant Types:{input.types}'"
        " 'Size Distribution:{input.sizedist}'"
        " 'AF Spectrum:{input.af}'"
        " 'Per-Sample Types:{input.per_sample}'"


# --- Per-chromosome deconstruct breakdown (Panel 3) ---

rule deconstruct_by_chrom:
    """Per-chromosome breakdown plots (variant counts, AF, per-sample)"""
    resources:
        mem_mb=64000,
        runtime=960,
    input:
        stats=expand(f"{OUT}/{{c}}.sites.vcf-stats.tsv", c=CHROMS),
        per_sample=expand(f"{OUT}/{{c}}.sites.per-sample-types.tsv", c=CHROMS),
        records=expand(f"{OUT}/{{c}}.sites.records.tsv", c=CHROMS),
    output:
        snp_counts=f"{OUT}/all.by-chrom.snp-counts.png",
        indel_counts=f"{OUT}/all.by-chrom.indel-counts.png",
        sv_counts=f"{OUT}/all.by-chrom.sv-counts.png",
        af=f"{OUT}/all.by-chrom.af-spectrum.png",
        ps_snp=f"{OUT}/all.by-chrom.per-sample-snp.png",
        ps_indel=f"{OUT}/all.by-chrom.per-sample-indel.png",
        ps_sv=f"{OUT}/all.by-chrom.per-sample-sv.png",
        ps_snp_onref=f"{OUT}/all.by-chrom.per-sample-snp-onref.png",
        ps_indel_onref=f"{OUT}/all.by-chrom.per-sample-indel-onref.png",
        ps_sv_onref=f"{OUT}/all.by-chrom.per-sample-sv-onref.png",
        ps_snp_combined=f"{OUT}/all.by-chrom.per-sample-snp-combined.png",
        ps_indel_combined=f"{OUT}/all.by-chrom.per-sample-indel-combined.png",
        ps_sv_combined=f"{OUT}/all.by-chrom.per-sample-sv-combined.png",
    params:
        stats_labeled=lambda wc, input: " ".join(
            f"{os.path.basename(f).replace('.sites.vcf-stats.tsv', '')}:{f}"
            for f in input.stats
        ),
        ps_labeled=lambda wc, input: " ".join(
            f"{os.path.basename(f).replace('.sites.per-sample-types.tsv', '')}:{f}"
            for f in input.per_sample
        ),
        rec_labeled=lambda wc, input: " ".join(
            f"{os.path.basename(f).replace('.sites.records.tsv', '')}:{f}"
            for f in input.records
        ),
    shell:
        "{RSCRIPT} {SCRIPTS}/vcf-stats-by-chrom.R"
        " {OUT}/all.by-chrom"
        " --stats {params.stats_labeled}"
        " --per-sample {params.ps_labeled}"
        " --records {params.rec_labeled}"


rule summary_deconstruct_by_chrom:
    resources:
        mem_mb=32000,
        runtime=960,
    """Compose per-chromosome variant counts + AF (figure 3)"""
    input:
        snp=f"{OUT}/all.by-chrom.snp-counts.png",
        indel=f"{OUT}/all.by-chrom.indel-counts.png",
        sv=f"{OUT}/all.by-chrom.sv-counts.png",
        af=f"{OUT}/all.by-chrom.af-spectrum.png",
    output:
        f"{OUT}/3.deconstruct-by-chrom.png",
    shell:
        "python3 {SCRIPTS}/compose-summary.py"
        " --output {output}"
        " --title 'Deconstruct by Chromosome'"
        " --cols 2"
        " --panels"
        " 'SNP Counts:{input.snp}'"
        " 'MNP / Indel Counts:{input.indel}'"
        " 'SV Counts:{input.sv}'"
        " 'AF Spectrum:{input.af}'"


rule summary_per_sample_by_chrom:
    resources:
        mem_mb=32000,
        runtime=960,
    """Compose per-sample by chromosome (figure 4)"""
    input:
        snp=f"{OUT}/all.by-chrom.per-sample-snp.png",
        indel=f"{OUT}/all.by-chrom.per-sample-indel.png",
        sv=f"{OUT}/all.by-chrom.per-sample-sv.png",
        snp_onref=f"{OUT}/all.by-chrom.per-sample-snp-onref.png",
        indel_onref=f"{OUT}/all.by-chrom.per-sample-indel-onref.png",
        sv_onref=f"{OUT}/all.by-chrom.per-sample-sv-onref.png",
    output:
        f"{OUT}/4.per-sample-by-chrom.png",
    shell:
        "python3 {SCRIPTS}/compose-summary.py"
        " --output {output}"
        " --title 'Deconstruct Per-Sample Counts by Chromosome'"
        " --cols 2"
        " --panels"
        " ' :{input.snp}'"
        " ' :{input.snp_onref}'"
        " ' :{input.indel}'"
        " ' :{input.indel_onref}'"
        " ' :{input.sv}'"
        " ' :{input.sv_onref}'"


rule concat_per_sample_by_chrom:
    """Concatenate per-chrom per-sample TSVs with chrom column (4b source data)"""
    input:
        expand(f"{OUT}/{{c}}.sites.per-sample-types.tsv", c=CHROMS),
    output:
        f"{OUT}/4b.per-sample-by-chrom.tsv",
    run:
        with open(output[0], "w") as out:
            out.write("chrom\tsample\tvariant_type\tref_context\tcount\n")
            for f in input:
                chrom = os.path.basename(f).replace(".sites.per-sample-types.tsv", "")
                with open(f) as inp:
                    next(inp)
                    for line in inp:
                        out.write(f"{chrom}\t{line}")


rule summary_per_sample_by_chrom_combined:
    """Compose compact per-sample by chromosome, off+on-ref overlaid (figure 4b)"""
    resources:
        mem_mb=32000,
        runtime=960,
    input:
        snp=f"{OUT}/all.by-chrom.per-sample-snp-combined.png",
        indel=f"{OUT}/all.by-chrom.per-sample-indel-combined.png",
        sv=f"{OUT}/all.by-chrom.per-sample-sv-combined.png",
    output:
        f"{OUT}/4b.per-sample-by-chrom-combined.png",
    shell:
        "python3 {SCRIPTS}/compose-summary.py"
        " --output {output}"
        " --title 'Deconstruct Per-Sample Counts by Chromosome (off- + on-ref)'"
        " --cols 1"
        " --panels"
        " ' :{input.snp}'"
        " ' :{input.indel}'"
        " ' :{input.sv}'"


# --- Per-haplotype variants (deconstruct) ---


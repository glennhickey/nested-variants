    rule call_by_chrom:
        """Per-chromosome call breakdown plots"""
        resources:
            mem_mb=128000,
            runtime=480,
        input:
            stats=expand(f"{OUT}/{{c}}.call.sites.pass.vcf-stats.tsv", c=CALL_CHROMS),
            per_sample=expand(f"{OUT}/{{c}}.call.sites.pass.per-sample-types.tsv", c=CALL_CHROMS),
            records=expand(f"{OUT}/{{c}}.call.sites.pass.records.tsv", c=CALL_CHROMS),
        output:
            snp_counts=f"{OUT}/all.call.by-chrom.snp-counts.png",
            indel_counts=f"{OUT}/all.call.by-chrom.indel-counts.png",
            sv_counts=f"{OUT}/all.call.by-chrom.sv-counts.png",
            af=f"{OUT}/all.call.by-chrom.af-spectrum.png",
            ps_snp=f"{OUT}/all.call.by-chrom.per-sample-snp.png",
            ps_indel=f"{OUT}/all.call.by-chrom.per-sample-indel.png",
            ps_sv=f"{OUT}/all.call.by-chrom.per-sample-sv.png",
        params:
            stats_labeled=lambda wc, input: " ".join(
                f"{os.path.basename(f).replace('.call.sites.pass.vcf-stats.tsv', '')}:{f}"
                for f in input.stats),
            ps_labeled=lambda wc, input: " ".join(
                f"{os.path.basename(f).replace('.call.sites.pass.per-sample-types.tsv', '')}:{f}"
                for f in input.per_sample),
            rec_labeled=lambda wc, input: " ".join(
                f"{os.path.basename(f).replace('.call.sites.pass.records.tsv', '')}:{f}"
                for f in input.records),
        shell:
            "Rscript {SCRIPTS}/vcf-stats-by-chrom.R"
            " {OUT}/all.call.by-chrom"
            " --stats {params.stats_labeled}"
            " --per-sample {params.ps_labeled}"
            " --records {params.rec_labeled}"


    rule dv_by_chrom:
        """Per-chromosome DV breakdown plots"""
        resources:
            mem_mb=128000,
            runtime=480,
        input:
